model Tenant {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  password     String

  phone        String?
  address      String?
  profileImage String?

  role         Role            @default(TENANT)
  status       Status          @default(ACTIVE)

  isDeleted    Boolean         @default(false)

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  profile        Profile?
  rentalRequests RentalRequest[]
  reviews        Review[]
  payments       Payment[]
}